# ==============================================================================
# HeroTyping Environment Configuration
# Copy this file to .env.local for local development overrides.
# NOTE: In Next.js, variables prefixed with NEXT_PUBLIC_ are inlined at build time.
# Ensure all required public environment variables are set in your deployment environment.
# ==============================================================================

# Public Canonical Site URL
# Defaults to https://herotyping.com if unset.
# Used for canonical links, OpenGraph metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://herotyping.com

# Google AdSense Publisher Client ID
# Format: ca-pub-XXXXXXXXXXXXXXXX (leave unset or empty to keep ads disabled)
# Ads are only initialized when this variable is set to a valid publisher client ID.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Support Contact Email
# Defaults to hello@herotyping.com if unset.
# Rendered on /privacy, /terms, and contact footers.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@herotyping.com


NEXT_PUBLIC_SUPABASE_URL=https://humzucvcxyapcxkrmutj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4jYCbNHvfcUYhstD6_QZyA_iwV3hD-X

# Public OAuth client id (not a secret) for Google Identity Services --
# renders Google's own "Sign in with Google" button client-side, so the
# account picker is attributed to this site's origin rather than Supabase's
# hosted auth redirect domain. Same value as the "Authorized JavaScript
# origins" OAuth client in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=451135749486-sb7a35l4kaae5ojknco955mttjc646ns.apps.googleusercontent.com

# ==============================================================================
# Server-Only Privileged Key (New Supabase API Key Model: sb_secret_...)
# Used strictly in Vercel server-side route handlers / data services.
# CRITICAL: NEVER prefix with NEXT_PUBLIC_. NEVER expose to the browser bundle.
# ==============================================================================
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here