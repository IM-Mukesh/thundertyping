# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code (local/agent-managed, not shared project config)
# also keeps Tailwind v4's automatic content detection from trying to read
# these - it honours .gitignore, and some of them are unreadable special files
# that otherwise fail the build with "Permission denied".
/.claude/
/.mcp.json

# Stray shell/IDE dotfiles that land in the project root in some sandboxed
# dev environments (where $HOME resolves here) rather than a real home
# directory - not project config, never meant to be shared/committed.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc

# typescript
*.tsbuildinfo
next-env.d.ts

# raw AI-image output before processing
# Flow originals are large PNGs that get watermark-stripped and converted to
# WebP into public/games by scripts/process-flow-batch.sh. Only the processed
# WebP is committed: git stores binaries as whole new blobs forever, so
# committing raw art means every regenerated character stays in history at
# full size for good. Tailwind v4's content detection also honours this file,
# so keeping the folder ignored keeps it out of the build scan.
/assets-raw/
# scratch files
/scratch/
