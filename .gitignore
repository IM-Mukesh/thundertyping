# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (local/agent-managed, not shared project config)
# also keeps Tailwind v4's automatic content detection from trying to read
# these - it honours .gitignore, and some of them are unreadable special files
# that otherwise fail the build with "Permission denied".
/.claude/
/.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts
